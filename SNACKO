```html
<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SNACKO — Gustul pauzei!</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f5f5f5;
    color: #111;
}

header {
    background: #111;
    color: white;
    padding: 18px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 10;
}

.logo {
    font-size: 30px;
    font-weight: 900;
    letter-spacing: 2px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 25px;
    font-weight: bold;
}

.cart-button {
    background: white;
    color: #111;
    border: none;
    padding: 10px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
}

.hero {
    padding: 70px 7%;
    background: linear-gradient(135deg, #111, #333);
    color: white;
    text-align: center;
}

.hero h1 {
    font-size: 55px;
    margin-bottom: 12px;
}

.hero p {
    font-size: 22px;
}

.search {
    width: 86%;
    max-width: 600px;
    margin: 30px auto;
    display: block;
    padding: 15px;
    border: 1px solid #ccc;
    border-radius: 10px;
    font-size: 16px;
}

.categories {
    text-align: center;
    margin: 20px;
}

.categories button {
    padding: 10px 18px;
    margin: 5px;
    border: none;
    border-radius: 20px;
    cursor: pointer;
    background: #ddd;
    font-weight: bold;
}

.categories button:hover {
    background: #111;
    color: white;
}

.products {
    width: 86%;
    max-width: 1200px;
    margin: 30px auto 80px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 25px;
}

.product {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 18px rgba(0,0,0,.1);
}

.product img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    background: #ddd;
}

.product-info {
    padding: 18px;
}

.product h3 {
    margin-bottom: 8px;
}

.price {
    font-size: 20px;
    font-weight: bold;
    margin: 12px 0;
}

.add {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 8px;
    background: #111;
    color: white;
    cursor: pointer;
    font-weight: bold;
}

.add:hover {
    background: #333;
}

/* COȘ */

.cart {
    position: fixed;
    right: -430px;
    top: 0;
    width: 400px;
    max-width: 95%;
    height: 100%;
    background: white;
    z-index: 30;
    padding: 25px;
    box-shadow: -5px 0 20px rgba(0,0,0,.2);
    transition: .3s;
    overflow-y: auto;
}

.cart.open {
    right: 0;
}

.close {
    float: right;
    border: none;
    background: none;
    font-size: 25px;
    cursor: pointer;
}

.cart h2 {
    margin-bottom: 25px;
}

.cart-item {
    border-bottom: 1px solid #ddd;
    padding: 15px 0;
}

.cart-item strong {
    display: block;
    margin-bottom: 7px;
}

.quantity {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
}

.quantity button {
    width: 28px;
    height: 28px;
    border: none;
    background: #ddd;
    border-radius: 5px;
    cursor: pointer;
}

.total {
    font-size: 22px;
    font-weight: bold;
    margin: 25px 0;
}

.checkout {
    width: 100%;
    padding: 15px;
    background: #111;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;
    font-weight: bold;
}

/* MODAL */

.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.65);
    z-index: 50;
    align-items: center;
    justify-content: center;
}

.modal-box {
    background: white;
    width: 90%;
    max-width: 500px;
    padding: 30px;
    border-radius: 15px;
}

.modal-box h2 {
    margin-bottom: 15px;
}

.modal-box input {
    width: 100%;
    padding: 13px;
    margin: 7px 0;
    border: 1px solid #ccc;
    border-radius: 7px;
}

.demo {
    background: #fff3cd;
    padding: 12px;
    border-radius: 8px;
    margin: 15px 0;
    font-size: 14px;
}

.modal-buttons {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.modal-buttons button {
    flex: 1;
    padding: 13px;
    border: none;
    border-radius: 7px;
    cursor: pointer;
    font-weight: bold;
}

.send {
    background: #111;
    color: white;
}

.cancel {
    background: #ddd;
}

footer {
    background: #111;
    color: white;
    text-align: center;
    padding: 30px;
}

@media(max-width:600px) {
    .hero h1 {
        font-size: 40px;
    }

    .cart {
        width: 95%;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">SNACKO</div>

    <nav>
        <a href="#shop">SHOP</a>
        <a href="#about">DESPRE</a>
        <button class="cart-button" onclick="openCart()">
            🛒 Coș (<span id="cartCount">0</span>)
        </button>
    </nav>
</header>

<section class="hero">
    <h1>SNACKO</h1>
    <p>Gustul pauzei!</p>
</section>

<input
    id="search"
    class="search"
    type="text"
    placeholder="Caută gumă, chipsuri, pufuleți..."
    oninput="renderProducts()"
>

<div class="categories">
    <button onclick="setCategory('all')">Toate</button>
    <button onclick="setCategory('guma')">Gumă</button>
    <button onclick="setCategory('chipsuri')">Chipsuri</button>
    <button onclick="setCategory('pufuleti')">Pufuleți</button>
</div>

<section id="shop" class="products"></section>

<!-- COȘ -->

<div id="cart" class="cart">
    <button class="close" onclick="closeCart()">×</button>

    <h2>Coșul tău</h2>

    <div id="cartItems"></div>

    <div class="total">
        Total: <span id="cartTotal">0.00</span> lei
    </div>

    <button class="checkout" onclick="openCheckout()">
        Finalizează comanda
    </button>
</div>

<!-- CHECKOUT -->

<div id="checkoutModal" class="modal">

    <div class="modal-box">

        <h2>Comandă SNACKO</h2>

        <div class="demo">
            ⚠️ ACEASTA ESTE O COMANDĂ DEMO.
            Nu se efectuează nicio plată reală.
            Folosește doar date fictive pentru demonstrație.
        </div>

        <input id="name" placeholder="Nume demo">

        <input id="email" type="email" placeholder="Email demo">

        <input id="address" placeholder="Adresă demo">

        <div class="modal-buttons">

            <button class="cancel" onclick="closeCheckout()">
                Anulează
            </button>

            <button class="send" onclick="sendOrder()">
                Trimite comanda
            </button>

        </div>

    </div>

</div>

<section id="about" style="padding:50px 7%; text-align:center;">
    <h2>Despre SNACKO</h2>
    <br>
    <p>
        SNACKO este un magazin online fictiv creat pentru demonstrații
        și distracție între colegi.
    </p>
</section>

<footer>
    © 2026 SNACKO — Gustul pauzei!
</footer>

<script>

const products = [

    {
        name: "Gumă Fresh Mint",
        category: "guma",
        price: 4.99,
        image: "images/guma1.jpg"
    },

    {
        name: "Gumă Strawberry",
        category: "guma",
        price: 4.99,
        image: "images/guma2.jpg"
    },

    {
        name: "Gumă Blueberry",
        category: "guma",
        price: 5.49,
        image: "images/guma3.jpg"
    },

    {
        name: "Chipsuri Classic",
        category: "chipsuri",
        price: 7.99,
        image: "images/chips1.jpg"
    },

    {
        name: "Chipsuri Paprika",
        category: "chipsuri",
        price: 8.49,
        image: "images/chips2.jpg"
    },

    {
        name: "Chipsuri Cheese",
        category: "chipsuri",
        price: 8.49,
        image: "images/chips3.jpg"
    },

    {
        name: "Chipsuri Hot",
        category: "chipsuri",
        price: 8.99,
        image: "images/chips4.jpg"
    },

    {
        name: "Pufuleți Classic",
        category: "pufuleti",
        price: 4.99,
        image: "images/pufuleti1.jpg"
    },

    {
        name: "Pufuleți Cheese",
        category: "pufuleti",
        price: 5.49,
        image: "images/pufuleti2.jpg"
    },

    {
        name: "Pufuleți XXL",
        category: "pufuleti",
        price: 6.99,
        image: "images/pufuleti3.jpg"
    }

];

let cart = [];
let currentCategory = "all";

function setCategory(category) {
    currentCategory = category;
    renderProducts();
}

function renderProducts() {

    const container = document.getElementById("shop");
    const search = document.getElementById("search").value.toLowerCase();

    container.innerHTML = "";

    products
        .filter(product => {

            const categoryOK =
                currentCategory === "all" ||
                product.category === currentCategory;

            const searchOK =
                product.name.toLowerCase().includes(search);

            return categoryOK && searchOK;

        })
        .forEach((product, index) => {

            container.innerHTML += `

                <div class="product">

                    <img
                        src="${product.image}"
                        alt="${product.name}"
                        onerror="this.src='https://via.placeholder.com/500x400?text=SNACKO'"
                    >

                    <div class="product-info">

                        <h3>${product.name}</h3>

                        <div class="price">
                            ${product.price.toFixed(2)} lei
                        </div>

                        <button
                            class="add"
                            onclick="addToCart(${products.indexOf(product)})"
                        >
                            Adaugă în coș
                        </button>

                    </div>

                </div>

            `;

        });
}

function addToCart(index) {

    const existing = cart.find(
        item => item.index === index
    );

    if (existing) {
        existing.quantity++;
    } else {
        cart.push({
            index: index,
            quantity: 1
        });
    }

    updateCart();
}

function updateCart() {

    const container = document.getElementById("cartItems");

    container.innerHTML = "";

    let total = 0;
    let count = 0;

    cart.forEach((item, cartIndex) => {

        const product = products[item.index];

        total += product.price * item.quantity;
        count += item.quantity;

        container.innerHTML += `

            <div class="cart-item">

                <strong>${product.name}</strong>

                ${product.price.toFixed(2)} lei × ${item.quantity}

                <div class="quantity">

                    <button onclick="changeQuantity(${cartIndex}, -1)">
                        −
                    </button>

                    <span>${item.quantity}</span>

                    <button onclick="changeQuantity(${cartIndex}, 1)">
                        +
                    </button>

                </div>

            </div>

        `;

    });

    document.getElementById("cartTotal").textContent =
        total.toFixed(2);

    document.getElementById("cartCount").textContent =
        count;
}

function changeQuantity(index, amount) {

    cart[index].quantity += amount;

    if (cart[index].quantity <= 0) {
        cart.splice(index, 1);
    }

    updateCart();
}

function openCart() {
    document.getElementById("cart").classList.add("open");
}

function closeCart() {
    document.getElementById("cart").classList.remove("open");
}

function openCheckout() {

    if (cart.length === 0) {
        alert("Coșul este gol!");
        return;
    }

    document.getElementById("checkoutModal").style.display =
        "flex";
}

function closeCheckout() {

    document.getElementById("checkoutModal").style.display =
        "none";
}

function sendOrder() {

    const name =
        document.getElementById("name").value || "Client demo";

    const email =
        document.getElementById("email").value || "demo@example.com";

    const address =
        document.getElementById("address").value || "Adresă demo";

    let orderText = "";

    let total = 0;

    cart.forEach(item => {

        const product = products[item.index];

        const subtotal =
            product.price * item.quantity;

        total += subtotal;

        orderText +=
            `${product.name} x${item.quantity} - ${subtotal.toFixed(2)} lei\n`;

    });

    const subject =
        "SNACKO - Comandă demo nouă";

    const body =
`COMANDĂ DEMO SNACKO

Nume: ${name}
Email: ${email}
Adresă: ${address}

PRODUSE:
${orderText}
TOTAL: ${total.toFixed(2)} lei

Aceasta este o comandă DEMO.`;

    const mailto =
        "mailto:teo28gaina@gmail.com" +
        "?subject=" + encodeURIComponent(subject) +
        "&body=" + encodeURIComponent(body);

    window.location.href = mailto;
}

renderProducts();
updateCart();

</script>

</body>
</html>
